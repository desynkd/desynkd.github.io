---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/layout.astro";
import Container from "@/components/Container.astro";
import BackLink from "@/components/BackLink.astro";
import "@/styles/article.css";

interface Props {
  post: CollectionEntry<"blog">;
}
const { post } = Astro.props;
const { title, description, date, updated, tags } = post.data;

const wordCount = post.body?.trim().split(/\s+/).length ?? 0;
const readingTime = Math.max(1, Math.round(wordCount / 200));

const dateFormatted = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const updatedFormatted = updated?.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout title={`${title} — Ravindu Peeris`} description={description} ditherTier="C">
  <Container class="relative z-10">
    <BackLink class="mt-10" />
    <main class="py-12 sm:py-16">
      <header class="mb-12 max-w-(--measure)">
        {tags.length > 0 && (
          <ul class="mb-4 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <li class="rounded-(--radius-pill) bg-silver px-3 py-1 text-ui uppercase text-ink-soft">
                {tag}
              </li>
            ))}
          </ul>
        )}
        <h1 class="text-hero text-ink">{title}</h1>
        <p class="mt-4 text-ui uppercase text-ink-mute">
          {dateFormatted} · {readingTime} min read
          {updatedFormatted && <> · Updated {updatedFormatted}</>}
        </p>
      </header>

      <div class="article font-serif text-article text-ink-soft">
        <slot />
      </div>
    </main>
  </Container>
</BaseLayout>

<style>
  .article :global(h1),
  .article :global(h2),
  .article :global(h3) {
    font-family: var(--font-sans);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .article :global(h2) {
    font-size: 1.5rem;
  }
  .article :global(h3) {
    font-size: 1.25rem;
  }
  .article :global(ul),
  .article :global(ol) {
    padding-left: 1.25rem;
  }
  .article :global(ul) {
    list-style: disc;
  }
  .article :global(ol) {
    list-style: decimal;
  }
  .article :global(li) {
    margin-bottom: 0.5rem;
  }
  .article :global(a) {
    text-decoration: underline;
    text-decoration-color: var(--color-rule);
    text-underline-offset: 3px;
  }
  .article :global(a:hover) {
    text-decoration-color: var(--color-ink);
  }
  .article :global(blockquote) {
    border-left: 1px solid var(--color-rule);
    padding-left: 1.25rem;
    color: var(--color-ink-mute);
  }
  .article :global(pre) {
    padding: 1.25rem;
    border-radius: var(--radius-card);
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .article :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .article :global(p code),
  .article :global(li code) {
    background: var(--color-silver);
    padding: 0.125rem 0.375rem;
    border-radius: 0.375rem;
    font-size: 0.9em;
  }
</style>
