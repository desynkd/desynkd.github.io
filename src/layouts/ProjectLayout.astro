---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/layout.astro";
import Container from "@/components/Container.astro";
import BackLink from "@/components/BackLink.astro";
import StackChips from "@/components/StackChips.astro";

interface Props {
  project: CollectionEntry<"projects">;
}
const { project } = Astro.props;
const { title, outcome, role, timeframe, status, stack, repo, live } = project.data;

const statusLabel: Record<typeof status, string> = {
  shipped: "Shipped",
  "in-progress": "In progress",
  archived: "Archived",
};
---

<BaseLayout
  title={`${title} — Ravindu Peeris`}
  description={outcome}
  ditherTier="B"
>
  <Container class="relative z-10">
    <BackLink class="mt-10" />
    <main class="py-12 sm:py-16">
      <h1 class="text-hero text-ink">{title}</h1>
      <p class="mt-4 max-w-[42rem] text-body text-ink-soft">{outcome}</p>

      <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
        <span class="text-ui uppercase text-ink-mute">
          {role} · {timeframe} · {statusLabel[status]}
        </span>
        <div class="flex items-center gap-4">
          {repo && (
            <a
              href={repo}
              target="_blank"
              rel="noopener noreferrer"
              class="text-ui uppercase text-ink-soft transition-colors duration-200 hover:text-ink"
            >
              Repo ↗
            </a>
          )}
          {live && (
            <a
              href={live}
              target="_blank"
              rel="noopener noreferrer"
              class="text-ui uppercase text-ink-soft transition-colors duration-200 hover:text-ink"
            >
              Live ↗
            </a>
          )}
        </div>
      </div>

      <div class="prose-project mt-12 max-w-[42rem] text-body text-ink-soft">
        <slot />
      </div>

      <div class="mt-12">
        <h2 class="text-ui uppercase text-ink-mute">Stack</h2>
        <StackChips stack={stack} class="mt-3" />
      </div>
    </main>
  </Container>
</BaseLayout>

<style>
  .prose-project :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  .prose-project :global(p) {
    margin-bottom: 1.25rem;
  }
  .prose-project :global(ul) {
    margin-bottom: 1.25rem;
    padding-left: 1.25rem;
    list-style: disc;
  }
  .prose-project :global(li) {
    margin-bottom: 0.5rem;
  }
</style>
