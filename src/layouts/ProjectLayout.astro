---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/layout.astro";
import Container from "@/components/Container.astro";
import BackLink from "@/components/BackLink.astro";
import StackChips from "@/components/StackChips.astro";
import "@/styles/article.css";

interface Props {
  project: CollectionEntry<"projects">;
}
const { project } = Astro.props;
const { title, outcome, role, timeframe, status, stack, repo, live, image } = project.data;

const statusLabel: Record<typeof status, string> = {
  shipped: "Shipped",
  "in-progress": "In progress",
  archived: "Archived",
};
---

<BaseLayout title={title} description={outcome} image={image} ditherTier="B">
  <Container class="relative z-10">
    <BackLink class="mt-10" />
    <main class="py-12 sm:py-16">
      <header class="mb-12 max-w-(--measure)">
        <h1 class="text-hero text-ink">{title}</h1>
        <p class="mt-4 text-body text-ink-soft">{outcome}</p>

        <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
          <span class="text-ui uppercase text-ink-mute">
            {role} · {timeframe} · {statusLabel[status]}
          </span>
          <div class="flex items-center gap-4">
            {repo && (
              <a
                href={repo}
                target="_blank"
                rel="noopener noreferrer"
                class="text-ui uppercase text-ink-soft transition-colors duration-200 hover:text-ink"
              >
                Repo ↗
              </a>
            )}
            {live && (
              <a
                href={live}
                target="_blank"
                rel="noopener noreferrer"
                class="text-ui uppercase text-ink-soft transition-colors duration-200 hover:text-ink"
              >
                Live ↗
              </a>
            )}
          </div>
        </div>
      </header>

      <div class="post font-serif text-article text-ink-soft">
        <slot />
      </div>

      <div class="mt-12">
        <h2 class="text-ui uppercase text-ink-mute">Stack</h2>
        <StackChips stack={stack} class="mt-3" />
      </div>
    </main>
  </Container>
</BaseLayout>
