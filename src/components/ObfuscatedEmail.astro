---
// Mail link whose address is assembled client-side, so it never appears in the
// markup. Renders a short label ("Email" by default) instead of the address.
import { site } from "@/lib/site";

interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
const { user, domain } = site.email;
---

<a
  class:list={["obfuscated-email", className]}
  data-user={user}
  data-domain={domain}
  href="#"
>
  <slot>Email</slot>
</a>

<script>
  document.querySelectorAll<HTMLAnchorElement>(".obfuscated-email").forEach((el) => {
    const { user, domain } = el.dataset;
    el.href = `mailto:${user}@${domain}`;
  });
</script>
