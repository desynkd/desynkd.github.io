---
// First-paint cover. Self-contained on purpose: the script, the styles and the
// markup all ship inline, in body order, so this works before the external
// stylesheet or any bundle has resolved. A scoped Astro <style> would be
// compiled into that stylesheet -- i.e. into the very asset we are covering for.
//
// The logo is an inlined path rather than <img src="/logo.svg"> for the same
// reason: a second request could not have arrived by the time this is needed.
---

<script is:inline>
  // Runs before the markup below is parsed, so a return visit never flashes the
  // overlay. Session-scoped: the grey screen belongs to the first paint of a
  // visit, not to every navigation inside it.
  try {
    if (sessionStorage.getItem("visited")) {
      document.documentElement.classList.add("no-preloader");
    } else {
      sessionStorage.setItem("visited", "1");
    }
  } catch (err) {
    // Private mode / storage disabled: show the overlay rather than fail.
  }
</script>

<style is:inline>
  /* Literal hex, not var(--color-paper-raised): the theme tokens live in the
     stylesheet this element exists to cover for. Keep in sync with global.css. */
  #preloader {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    background: #EDEDEA;
    color: #232326;
  }

  #preloader svg {
    width: clamp(3.25rem, 11vw, 8.25rem);
    height: auto;
    opacity: 0.05;
    animation: preloader-pulse 3.2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  /* CSS, not GSAP: the pulse has to be running at first paint, and GSAP arrives
     with a deferred bundle. The overlay's exit is GSAP's job -- by then it has
     loaded, and the reveal timeline needs to chain off it. */
  @keyframes preloader-pulse {
    0%,
    100% {
      opacity: 0.05;
    }
    50% {
      opacity: 0.15;
    }
  }

  html.no-preloader #preloader {
    display: none;
  }
</style>

<div id="preloader" aria-hidden="true">
