---
// Standalone on purpose: this page carries Everglae's own branding and must
// read without JavaScript, so it skips the portfolio layout (preloader, shader,
// reveal script, footer) and its global stylesheet.
import { privacy, CONTACT, PUBLISHER } from "@/data/everglae-legal";

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const description =
  "Privacy policy for Everglae, an Android app that locks distracting apps. Everglae collects nothing; everything it uses stays on your phone.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Everglae – Privacy Policy</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/everglae/mascot.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/everglae/mascot-192.png" />
    <meta name="theme-color" content="#F5D866" />
    <meta name="color-scheme" content="light dark" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="Everglae – Privacy Policy" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />

    <link
      rel="preload"
      href="/fonts/google-sans.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <header class="band">
      <div class="column band-inner">
        <img
          class="icon"
          src="/everglae/icon.png"
          alt=""
          width="64"
          height="64"
        />
        <div>
          <p class="brand">Everglae</p>
          <p class="summary">{privacy.text}</p>
        </div>
      </div>
    </header>

    <main class="column">
      <h1>{privacy.title}</h1>
      <p class="updated">Last updated {privacy.updated}</p>

      {
        privacy.sections.map((section) => (
          <section>
            <h2>{section.heading}</h2>
            {section.body.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </section>
        ))
      }
    </main>

    <footer class="column foot">
      <p>
        <a href={`mailto:${CONTACT}`}>{CONTACT}</a>
      </p>
      <p>© {PUBLISHER}</p>
    </footer>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Google Sans";
    font-style: normal;
    font-weight: 400 700;
    font-display: swap;
    src: url("/fonts/google-sans.woff2") format("woff2");
  }

  :root {
    --bg: #f5f4ef;
    --text: #1b1b1d;
    --muted: #606064;
    --border: #dcd9cf;
    --accent: #f5d866;
    --ink: #1b1b1d;
    --link: #1b1b1d;
    color-scheme: light dark;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #111113;
      --text: #f5f4ef;
      --muted: #a3a29c;
      --border: #2a2a2e;
      --link: #f5d866;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: "Google Sans", system-ui, -apple-system, "Segoe UI", Roboto,
      sans-serif;
    font-weight: 400;
    font-size: 1rem;
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  .column {
    width: 100%;
    max-width: 680px;
    margin-inline: auto;
    padding-inline: 16px;
  }

  .band {
    background: var(--accent);
    color: var(--ink);
    padding-block: 32px 40px;
    border-radius: 0 0 40px 40px;
  }

  .band-inner {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .icon {
    flex: none;
    width: 64px;
    height: 64px;
    border-radius: 50%;
  }

  .brand {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .summary {
    margin: 4px 0 0;
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.45;
  }

  main {
    padding-block: 40px 24px;
  }

  h1 {
    margin: 0;
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .updated {
    margin: 8px 0 0;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  section {
    margin-top: 40px;
  }

  h2 {
    margin: 0 0 12px;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
  }

  section p {
    margin: 0 0 14px;
  }

  .foot {
    margin-top: 24px;
    padding-block: 24px 48px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .foot p {
    margin: 0 0 4px;
  }

  .foot a {
    color: var(--link);
    font-weight: 500;
  }

  @media (min-width: 640px) {
    .column {
      padding-inline: 24px;
    }

    .band {
      padding-block: 48px 56px;
      border-radius: 0 0 64px 64px;
    }

    .icon {
      width: 80px;
      height: 80px;
    }

    .brand {
      font-size: 2.25rem;
    }

    h1 {
      font-size: 2.5rem;
    }
  }
</style>
