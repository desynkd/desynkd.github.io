---
import { site } from "@/lib/site";

interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<span
  class:list={[
    "inline-flex items-center gap-2 rounded-(--radius-pill) bg-paper-raised px-3 py-1.5 text-ui uppercase text-ink-soft",
    className,
  ]}
>
  <span
    class:list={[
      "size-1.5 rounded-full",
      site.available ? "bg-ink" : "bg-ink-mute",
    ]}
    aria-hidden="true"
  ></span>
  {site.available ? "Available for work" : "Not currently available"}
</span>
