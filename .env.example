# Cloudflare R2 — build-time content source.
# Create a read-only R2 API token in the Cloudflare dashboard:
#   R2 > API > Manage API Tokens > Create Account API Token
#   Permission: "Object Read only", scoped to the `prjkt` bucket.
# Copy this file to `.env` (gitignored) and fill in the values.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional — these are the defaults.
# R2_BUCKET=prjkt
# R2_PREFIX=port
